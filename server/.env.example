# Never commit real values. Generate a 32+ byte random JWT secret.
PORT=8080
DATABASE_URL=postgresql://edumanage:change-me@localhost:5432/edumanage_licensing
JWT_SECRET=replace-with-at-least-32-random-bytes
ADMIN_EMAIL=admin@example.invalid
# Argon2id PHC hash, generated out-of-band; never store a plaintext admin password.
ADMIN_PASSWORD_HASH=replace-with-argon2id-phc-hash
# PEM PKCS8 Ed25519 private key, stored in a secret manager/KMS in production.
LICENSE_SIGNING_PRIVATE_KEY_PEM=replace-with-secret-manager-injected-pem
